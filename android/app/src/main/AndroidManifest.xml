<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permisos -->

    <!-- El reconocimiento de voz usa el micrófono. Se pide una sola vez, en el
         momento en que tocás el botón de voz por primera vez. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Internet: lo necesita el reconocedor de Google cuando resuelve en la nube.
         Si el teléfono tiene bajado el paquete de español para uso sin conexión,
         resuelve en el aparato y no hace falta. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Recordatorios. Desde Android 13 el permiso se pide además en
         tiempo de ejecución; lo hace el plugin la primera vez. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Para que los recordatorios caigan a la hora puesta y no cuando el
         sistema tenga ganas. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Desde Android 11 una app sólo "ve" los servicios que declara. Sin esto,
         el reconocedor de voz del sistema es invisible para la app. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
